@model RentalGameDemo.Models.RentalOrder

@{
    ViewData["Title"] = "Rental Summary";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

<div class="container py-4">
    <div class="card shadow-sm mx-auto" style="max-width: 600px;">
        <div class="card-body p-4">
            <h2 class="mb-4">Rental Summary</h2>

            <p>
                <strong>Game:</strong>
                @Model.Game?.Title
            </p>

            <p>
                <strong>Start Time:</strong>
                @Model.StartTime.ToString("dd/MM/yyyy HH:mm")
            </p>

            <p>
                <strong>End Time:</strong>
                @Model.EndTime.ToString("dd/MM/yyyy HH:mm")
            </p>

            <p>
                <strong>Duration:</strong>
                @ViewBag.Duration Hours
            </p>

            <hr />

            <h4 class="text-primary">
                Total: @(((decimal)ViewBag.Amount).ToString("N0")) VND
            </h4>

            <form asp-controller="Rental"
                  asp-action="ConfirmRental"
                  method="post">

                <button type="submit"
                        class="btn btn-success w-100 mt-3">
                    Confirm and Pay
                </button>
            </form>

            <form asp-controller="Rental"
                  asp-action="CancelRental"
                  method="post">

                <button type="submit"
                        class="btn btn-outline-secondary w-100 mt-2">
                    Cancel Rental
                </button>
            </form>
        </div>
    </div>
</div>
