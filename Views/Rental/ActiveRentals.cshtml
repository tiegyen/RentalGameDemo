@model RentalGameDemo.ViewModels.RentalUI

@{
    ViewData["Title"] = "Active Rentals";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<h2>My Active Rentals</h2>

@if (Model.activeRentalOrders.Count == 0)
{
    <p>You do not have any active rentals.</p>
}
else
{
    foreach (var order in Model.activeRentalOrders)
    {
        <div class="card mb-3 p-3">
            <h4>@order.Game.Title</h4>

            <p>Order ID: @order.OrderId</p>
            <p>Start Time: @order.StartTime</p>
            <p>End Time: @order.EndTime</p>
            <p>Status: @order.Status</p>

            <p>
                Steam Account:
                @order.SteamAccount.AccountName
            </p>

            <p>
                Password:
                <span id="password-@order.OrderId">********</span>
            </p>

            <button type="button"
                    onclick="togglePassword(
                                @order.OrderId,
                                '@order.SteamAccount.AccountPassword')">
                Unmask Password
            </button>

            <p>
                Verification Code:
                @order.SteamAccount.VerificationCode
            </p>

            <p>
                Remaining Time:
                <span id="countdown-@order.OrderId"
                      data-end="@order.EndTime.ToString("o")">
                    Calculating...
                </span>
            </p>

            <form asp-controller="Rental"
                  asp-action="RequestExtension"
                  method="post">
                <input type="hidden"
                       name="orderId"
                       value="@order.OrderId" />

                <input type="number"
                       name="extensionDuration"
                       min="1"
                       required />

                <button type="submit">
                    Extend Rental
                </button>
            </form>
        </div>
    }
}

<script>
    function togglePassword(orderId, password) {
        const element =
            document.getElementById("password-" + orderId);

        if (element.textContent === "********") {
            element.textContent = password;
        } else {
            element.textContent = "********";
        }
    }

    function updateCountdowns() {
        document.querySelectorAll("[id^='countdown-']")
            .forEach(element => {
                const endTime = new Date(element.dataset.end);
                const remaining = endTime - new Date();

                if (remaining <= 0) {
                    element.textContent = "00:00:00";
                    return;
                }

                const totalSeconds =
                    Math.floor(remaining / 1000);

                const hours =
                    Math.floor(totalSeconds / 3600);

                const minutes =
                    Math.floor((totalSeconds % 3600) / 60);

                const seconds = totalSeconds % 60;

                element.textContent =
                    String(hours).padStart(2, "0") + ":" +
                    String(minutes).padStart(2, "0") + ":" +
                    String(seconds).padStart(2, "0");
            });
    }

    updateCountdowns();
    setInterval(updateCountdowns, 1000);
</script>
